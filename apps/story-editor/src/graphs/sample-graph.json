      "data": {
        "promptRef": "story_prompts.story_continuation",
        "contextWindow": 3
      }
    },
    {
      "id": "finale-node",
      "type": "finale-prompt",
      "position": { "x": 660, "y": 40 },
      "data": {
        "promptRef": "story_prompts.story_finale"
      }
    },
    {
      "id": "telemetry-node",
      "type": "telemetry-logger",
      "position": { "x": 880, "y": 0 },
