{
  "name": "kids-chatbot-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.7.0",
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace story-api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.35",
    "@types/react-dom": "^18.2.14",
    "eslint": "^8.56.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
